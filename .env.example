# Copie para .env e preencha. NUNCA versione o .env.
DEBUG=1
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
# Banco "local" do Django. Vazio = SQLite local. Em producao: URL Postgres da hospedagem.
DATABASE_URL=
# Banco remoto (Equipe / Quem Somos)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_KEY=chave-service-role-somente-no-servidor
# E-mail (recuperacao de senha). Padrao: imprime o link no terminal/log.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Carvalhos <nao-responda@carvalhos.local>
# Pasta de uploads (em producao aponte para um volume persistente)
MEDIA_ROOT=
